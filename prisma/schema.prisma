// VibeCore Framework Starter Kit. ตารางระดับแพลตฟอร์ม (ไม่มี tenant_id): users, permissions, auth_tokens, login_throttles
generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScopeType {
  ALL
  CAMPUS
  ORG_UNIT
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  nameTh    String   @map("name_th") @db.VarChar(255)
  nameEn    String   @map("name_en") @db.VarChar(255)
  logoUrl   String?  @map("logo_url") @db.VarChar(500)
  /// { palette?: "blue"|"coral"|"pink"|"green"|"purple" }
  settings  Json     @default("{}") @db.JsonB
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  userTenants         UserTenant[]
  roles               Role[]
  auditLogs           AuditLog[]
  sampleItems         SampleItem[]
  newsArticles        NewsArticle[]
  newsAttachments     NewsAttachment[]
  certificateTypes    CertificateType[]
  certificateRequests CertificateRequest[]
  departments         Department[]
  personnels          Personnel[]
  curricula           Curriculum[]
  adminDocuments      AdminDocument[]
  meetingRooms        MeetingRoom[]
  meetingBookings     MeetingBooking[]
  students            Student[]
  courses             Course[]
  courseTeachers      CourseTeacher[]
  courseEnrollments   CourseEnrollment[]
  classSessions       ClassSession[]
  attendanceRecords   AttendanceRecord[]
  attendanceAuditLogs AttendanceAuditLog[]
  attendanceClasses   AttendanceClass[]
  attendanceSessions  AttendanceSession[]
  events              Event[]
  eventRegistrations  EventRegistration[]
  curriculumTimetables CurriculumTimetable[]

  @@map("tenants")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  /// เก็บตัวพิมพ์เล็กเสมอ
  email              String    @unique @db.VarChar(255)
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  /// ชื่อที่แสดง
  name               String    @db.VarChar(255)
  imageUrl           String?   @map("image_url") @db.VarChar(500)
  /// credentials | google | microsoft
  provider           String    @default("credentials") @db.VarChar(20)
  providerId         String?   @map("provider_id") @db.VarChar(255)
  emailVerified      Boolean   @default(false) @map("email_verified")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /// th | en | null (= ตามเบราว์เซอร์/ค่าเริ่มต้น)
  locale             String?   @db.VarChar(5)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  userTenants         UserTenant[]
  authTokens          AuthToken[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  authoredNews        NewsArticle[]        @relation("NewsAuthor")
  reviewedNews        NewsArticle[]        @relation("NewsReviewer")
  certificateRequests CertificateRequest[]
  meetingBookings     MeetingBooking[]
  attendanceClasses   AttendanceClass[]
  primaryCourses      Course[]             @relation("CoursePrimaryInstructor")
  taughtCourses       CourseTeacher[]

  @@map("users")
}

model UserTenant {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  isActive Boolean  @default(true) @map("is_active")
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz()

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("user_tenants")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// A-Z 0-9 _ เช่น SUPER_ADMIN
  code        String   @db.VarChar(50)
  nameTh      String   @map("name_th") @db.VarChar(100)
  nameEn      String   @map("name_en") @db.VarChar(100)
  description String?  @db.VarChar(500)
  /// แก้สิทธิ์/ลบไม่ได้ · SUPER_ADMIN ได้ทุกสิทธิ์โดยไม่ต้องมีแถวใน role_permissions
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

/// ผู้ใช้มีได้หลายแถว (หลายบทบาท / บทบาทเดียวหลายขอบเขต) · unique ที่มี scope_id null ไม่กันซ้ำใน Postgres — service ต้องเขียนแบบลบทั้งชุดแล้วสร้างใหม่
model UserRole {
  id           String    @id @default(uuid()) @db.Uuid
  userTenantId String    @map("user_tenant_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  scopeType    ScopeType @default(ALL) @map("scope_type")
  /// campus_id หรือ org_unit_id หรือขอบเขตอื่นที่กำหนดเพิ่ม — null เมื่อ scope_type = ALL
  scopeId      String?   @map("scope_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  userTenant UserTenant @relation(fields: [userTenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userTenantId, roleId, scopeType, scopeId])
  @@index([roleId])
  @@map("user_roles")
}

/// seed จาก src/permissions.ts ทุกครั้ง ไม่แก้ผ่าน UI
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(50)
  action      String  @db.VarChar(50)
  description String? @db.VarChar(255)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// โทเคนใช้ครั้งเดียว — เก็บ sha256 ของโทเคน ไม่เก็บตัวจริง
model AuthToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash") @db.VarChar(128)
  /// EMAIL_VERIFY: { newEmail }
  payload   Json?        @db.JsonB
  expiresAt DateTime     @map("expires_at") @db.Timestamptz()
  usedAt    DateTime?    @map("used_at") @db.Timestamptz()
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// กันเดารหัสผ่าน แทน Redis · key = "email:<lower>" หรือ "ip:<addr>"
model LoginThrottle {
  key         String    @id @db.VarChar(320)
  failCount   Int       @default(0) @map("fail_count")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("login_throttles")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  /// เช่น user.create, user.suspend, role.update
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(50)
  entityId  String   @map("entity_id") @db.VarChar(64)
  before    Json?    @db.JsonB
  after     Json?    @db.JsonB
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// โมเดลตัวอย่าง (Sample CRUD) สำหรับให้นักเรียนดูเป็นแม่แบบในการพัฒนาฟีเจอร์ใหม่
model SampleItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String?  @db.Text
  status      String   @default("ACTIVE") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sample_items")
}

// =============================================================
// NEWS & ANNOUNCEMENTS MODULE
// =============================================================

enum NewsCategory {
  ACADEMIC
  EVENT
  GENERAL
  PROCUREMENT
  BUDDHIST_AFFAIRS
}

enum NewsStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

model NewsArticle {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  titleTh         String       @map("title_th") @db.VarChar(255)
  titleEn         String?      @map("title_en") @db.VarChar(255)
  slug            String       @db.VarChar(255)
  summaryTh       String?      @map("summary_th") @db.Text
  summaryEn       String?      @map("summary_en") @db.Text
  contentTh       String       @map("content_th") @db.Text
  contentEn       String?      @map("content_en") @db.Text
  coverImageUrl   String?      @map("cover_image_url") @db.VarChar(500)
  category        NewsCategory @default(GENERAL)
  status          NewsStatus   @default(DRAFT)
  isPinned        Boolean      @default(false) @map("is_pinned")
  pinOrder        Int?         @map("pin_order")
  viewCount       Int          @default(0) @map("view_count")
  publishedAt     DateTime?    @map("published_at") @db.Timestamptz()
  archivedAt      DateTime?    @map("archived_at") @db.Timestamptz()
  rejectionReason String?      @map("rejection_reason") @db.Text
  authorId        String       @map("author_id") @db.Uuid
  reviewerId      String?      @map("reviewer_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author      User             @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewer    User?            @relation("NewsReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  attachments NewsAttachment[]

  @@unique([tenantId, slug])
  @@index([tenantId, status, publishedAt])
  @@index([tenantId, category])
  @@map("news_articles")
}

model NewsAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  articleId  String   @map("article_id") @db.Uuid
  fileName   String   @map("file_name") @db.VarChar(255)
  fileUrl    String   @map("file_url") @db.VarChar(500)
  fileSize   Int      @map("file_size")
  mimeType   String   @map("mime_type") @db.VarChar(100)
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("news_attachments")
}

// =============================================================
// CERTIFICATES MODULE
// =============================================================

enum CertificateRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ประเภทของหนังสือรับรอง (Master Data)
model CertificateType {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name        String  @db.VarChar(255)
  description String? @db.Text
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests CertificateRequest[]

  @@index([tenantId])
  @@map("certificate_types")
}

// รายการคำร้องขอหนังสือรับรอง
model CertificateRequest {
  id                String @id @default(uuid()) @db.Uuid
  tenantId          String @map("tenant_id") @db.Uuid
  userId            String @map("user_id") @db.Uuid
  certificateTypeId String @map("certificate_type_id") @db.Uuid

  status CertificateRequestStatus @default(PENDING)
  reason String?                  @db.Text // กรณีปฏิเสธ
  note   String?                  @db.Text // หมายเหตุจากผู้ขอ

  // เก็บ URL ไฟล์เอกสารที่เจ้าหน้าที่ออกให้ (ถ้ามี)
  issuedDocumentUrl String? @map("issued_document_url") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  certificateType CertificateType @relation(fields: [certificateTypeId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([userId])
  @@index([certificateTypeId])
  @@map("certificate_requests")
}

// =============================================================
// PERSONNEL MODULE
// =============================================================

enum PersonnelType {
  EXECUTIVE // สายผู้บริหาร
  ACADEMIC // สายวิชาการ (อาจารย์)
  SUPPORT // สายสนับสนุน (เจ้าหน้าที่)
}

model Department {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  nameTh        String  @map("name_th") @db.VarChar(255)
  nameEn        String? @map("name_en") @db.VarChar(255)
  code          String? @db.VarChar(50)
  type          String? @default("DEPARTMENT") @db.VarChar(50)
  descriptionTh String? @map("description_th") @db.Text
  descriptionEn String? @map("description_en") @db.Text
  orderIndex    Int     @default(0) @map("order_index")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personnel   Personnel[]
  curriculums Curriculum[]
  timetables  CurriculumTimetable[]

  @@index([tenantId])
  @@map("departments")
}

model Personnel {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid

  firstNameTh String  @map("first_name_th") @db.VarChar(100)
  lastNameTh  String  @map("last_name_th") @db.VarChar(100)
  firstNameEn String? @map("first_name_en") @db.VarChar(100)
  lastNameEn  String? @map("last_name_en") @db.VarChar(100)

  positionTh String  @map("position_th") @db.VarChar(255) // ตำแหน่ง
  positionEn String? @map("position_en") @db.VarChar(255)

  type        PersonnelType @default(ACADEMIC)
  imageUrl    String?       @map("image_url") @db.VarChar(500)
  email       String?       @db.VarChar(255)
  phoneNumber String?       @map("phone_number") @db.VarChar(50)

  isActive   Boolean @default(true) @map("is_active")
  orderIndex Int     @default(0) @map("order_index")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, type])
  @@index([departmentId])
  @@map("personnel")
}

// =============================================================
// CURRICULUM MODULE
// =============================================================

enum DegreeLevel {
  BACHELOR
  MASTER
  DOCTORATE
  CERTIFICATE
}

model Curriculum {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid

  nameTh String  @map("name_th") @db.VarChar(255)
  nameEn String? @map("name_en") @db.VarChar(255)

  degree        DegreeLevel @default(BACHELOR)
  durationYears Int         @default(4) @map("duration_years")

  descriptionTh String? @map("description_th") @db.Text
  descriptionEn String? @map("description_en") @db.Text
  imageUrl      String? @map("image_url") @db.VarChar(500)

  isActive   Boolean @default(true) @map("is_active")
  orderIndex Int     @default(0) @map("order_index")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  timetables CurriculumTimetable[]

  @@index([tenantId, degree])
  @@index([departmentId])
  @@map("curriculums")
}

model CurriculumTimetable {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  curriculumId String?     @map("curriculum_id") @db.Uuid
  departmentId String?     @map("department_id") @db.Uuid

  titleTh      String      @map("title_th") @db.VarChar(255)
  titleEn      String?     @map("title_en") @db.VarChar(255)
  academicYear String      @default("2569") @map("academic_year") @db.VarChar(20)
  semester     Int         @default(1)
  yearLevel    Int         @default(1) @map("year_level")
  room         String?     @db.VarChar(100)
  termDates    String?     @map("term_dates") @db.VarChar(255)
  description  String?     @db.Text
  notes        String?     @db.Text

  /// รายการวิชาในตารางเรียน [{ id, dayOfWeek: 1..7, startTime: "09.00", endTime: "11.30", courseCode: "101 101", courseName: "Buddhism and Science", instructor: "...", room?: "...", periodLabel?: "Morning" }]
  scheduleData Json        @default("[]") @map("schedule_data") @db.JsonB

  isActive     Boolean     @default(true) @map("is_active")
  orderIndex   Int         @default(0) @map("order_index")

  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  curriculum   Curriculum? @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, academicYear, semester])
  @@index([curriculumId])
  @@index([departmentId])
  @@map("curriculum_timetables")
}

// =============================================================
// ADMINISTRATION MODULE
// =============================================================

enum DocumentCategory {
  FORM // แบบฟอร์ม
  MANUAL // คู่มือปฏิบัติงาน
  POLICY // ระเบียบ/ประกาศ
  OTHER // อื่นๆ
}

enum DocumentVisibility {
  PUBLIC // สาธารณะ
  INTERNAL // ภายใน (ต้องล็อกอิน)
}

model AdminDocument {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  title       String  @db.VarChar(255)
  description String? @db.Text
  fileUrl     String  @map("file_url") @db.VarChar(1000)

  category    DocumentCategory   @default(FORM)
  visibility  DocumentVisibility @default(PUBLIC)
  isPublished Boolean            @default(true) @map("is_published")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, category, visibility])
  @@map("admin_documents")
}

// =============================================================
// MEETINGS MODULE
// =============================================================

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model MeetingRoom {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name      String  @db.VarChar(255)
  capacity  Int     @default(10)
  equipment String? @db.Text
  imageUrl  String? @map("image_url") @db.VarChar(500)
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings MeetingBooking[]

  @@index([tenantId])
  @@map("meeting_rooms")
}

model MeetingBooking {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  roomId      String @map("room_id") @db.Uuid
  requesterId String @map("requester_id") @db.Uuid // ผู้จอง

  title     String   @db.VarChar(255) // หัวข้อการประชุม
  startTime DateTime @map("start_time") @db.Timestamptz()
  endTime   DateTime @map("end_time") @db.Timestamptz()

  status BookingStatus @default(PENDING)
  remark String?       @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room      MeetingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  requester User        @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([tenantId, roomId, status])
  @@index([startTime, endTime])
  @@map("meeting_bookings")
}

// =============================================================
// ACADEMIC & ATTENDANCE MODULE (OPTION B - ENTERPRISE DOMAIN DESIGN)
// =============================================================

enum CourseStatus {
  ACTIVE
  ARCHIVED
  CANCELLED
}

enum SessionType {
  REGULAR
  SPECIAL
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PENDING
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum EnrollmentStatus {
  ENROLLED
  DROPPED
  WITHDRAWN
}

model Student {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  studentCode String   @map("student_code") @db.VarChar(50)
  firstName   String   @map("first_name") @db.VarChar(100)
  lastName    String   @map("last_name") @db.VarChar(100)
  title       String?  @db.VarChar(50)
  yearLevel      Int      @default(1) @map("year_level")
  degree         String?  @default("ปริญญาตรี") @db.VarChar(100)
  curriculumName String?  @map("curriculum_name") @db.VarChar(255)
  department     String?  @db.VarChar(255)
  major          String?  @db.VarChar(255)
  gender         String?  @db.VarChar(20)
  studyStatus    String?  @default("ปกติ") @map("study_status") @db.VarChar(50)
  faculty        String?  @default("คณะพุทธศาสตร์") @db.VarChar(255)
  email          String?  @db.VarChar(255)
  phoneNumber    String?  @map("phone_number") @db.VarChar(50)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments CourseEnrollment[]

  @@unique([tenantId, studentCode])
  @@index([tenantId, yearLevel])
  @@map("students")
}

model Course {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  courseCode     String       @map("course_code") @db.VarChar(50)
  courseName     String       @map("course_name") @db.VarChar(255)
  courseNameEn   String?      @map("course_name_en") @db.VarChar(255)
  credits        Int          @default(3)
  section        String       @default("1") @db.VarChar(20)
  term           String       @db.VarChar(50) // e.g. "1/2569"
  academicYear   String       @default("2569") @map("academic_year") @db.VarChar(20)
  semester       Int          @default(1)
  description    String?      @db.Text
  targetSessions Int          @default(16) @map("target_sessions")
  room           String?      @db.VarChar(100)
  dayOfWeek      Int?         @map("day_of_week") // 1=จันทร์ .. 7=อาทิตย์
  startTime      String?      @map("start_time") @db.VarChar(20)
  endTime        String?      @map("end_time") @db.VarChar(20)
  status         CourseStatus @default(ACTIVE)

  /// กฎการคำนวณ: lateCountsAsFull (default true), excuseDeductsDenominator (default false), minPercent (default 80.0)
  calculationRules Json       @default("{\"lateCountsAsFull\": true, \"excuseDeductsDenominator\": false, \"minPercent\": 80.0}") @map("calculation_rules") @db.JsonB

  primaryTeacherId String     @map("primary_teacher_id") @db.Uuid
  isActive         Boolean    @default(true) @map("is_active")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryTeacher   User               @relation("CoursePrimaryInstructor", fields: [primaryTeacherId], references: [id], onDelete: Cascade)
  teachers         CourseTeacher[]
  enrollments      CourseEnrollment[]
  sessions         ClassSession[]

  @@unique([tenantId, courseCode, academicYear, semester, section])
  @@index([tenantId, academicYear, semester])
  @@index([tenantId, primaryTeacherId])
  @@map("courses")
}

model CourseTeacher {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  role      String   @default("TEACHER") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([tenantId, userId])
  @@map("course_teachers")
}

model CourseEnrollment {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  courseId   String           @map("course_id") @db.Uuid
  studentId  String           @map("student_id") @db.Uuid
  status     EnrollmentStatus @default(ENROLLED)
  enrolledAt DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz()
  notes      String?          @db.Text
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course     Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  records    AttendanceRecord[]

  @@unique([courseId, studentId])
  @@index([tenantId, courseId])
  @@index([tenantId, studentId])
  @@map("course_enrollments")
}

model ClassSession {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  courseId      String        @map("course_id") @db.Uuid
  sessionNumber Int           @default(1) @map("session_number")
  date          DateTime      @db.Timestamptz()
  startTime     String?       @map("start_time") @db.VarChar(20)
  endTime       String?       @map("end_time") @db.VarChar(20)
  room          String?       @db.VarChar(100)
  topic         String?       @db.VarChar(255)
  description   String?       @db.Text
  sessionType   SessionType   @default(REGULAR) @map("session_type")
  status        SessionStatus @default(SCHEDULED)
  isCounted     Boolean       @default(true) @map("is_counted") // คิดเวลาเรียนและสิทธิ์สอบหรือไม่
  
  // ฟิลด์สำหรับ Attendance Lock
  isLocked      Boolean       @default(false) @map("is_locked")
  lockedAt      DateTime?     @map("locked_at") @db.Timestamptz()
  lockedBy      String?       @map("locked_by") @db.VarChar(255)

  // ฟิลด์สำหรับ Dynamic Rolling QR Code เช็กชื่อในห้องเรียน
  qrCodeSecret  String?       @map("qr_code_secret") @db.VarChar(100)
  qrActiveUntil DateTime?     @map("qr_active_until") @db.Timestamptz()

  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course        Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  records       AttendanceRecord[]
  auditLogs     AttendanceAuditLog[]

  @@unique([courseId, sessionNumber])
  @@index([tenantId, courseId, date])
  @@map("class_sessions")
}

model AttendanceRecord {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  sessionId    String           @map("session_id") @db.Uuid
  enrollmentId String?          @map("enrollment_id") @db.Uuid

  studentCode  String           @map("student_code") @db.VarChar(50)
  studentName  String           @map("student_name") @db.VarChar(255)
  status       AttendanceStatus @default(PENDING)
  note         String?          @db.Text
  recordedBy   String?          @map("recorded_by") @db.VarChar(255) // ชื่อหรือรหัสผู้บันทึก

  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session      ClassSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollment   CourseEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@unique([sessionId, studentCode])
  @@index([tenantId, sessionId])
  @@index([enrollmentId])
  @@map("attendance_records")
}

model AttendanceAuditLog {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  sessionId    String           @map("session_id") @db.Uuid
  studentCode  String           @map("student_code") @db.VarChar(50)
  studentName  String           @map("student_name") @db.VarChar(255)
  oldStatus    AttendanceStatus @map("old_status")
  newStatus    AttendanceStatus @map("new_status")
  reason       String           @db.Text
  actorId      String           @map("actor_id") @db.Uuid
  actorName    String           @map("actor_name") @db.VarChar(255)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session      ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessionId])
  @@index([studentCode])
  @@map("attendance_audit_logs")
}

// -------------------------------------------------------------
// LEGACY COMPATIBILITY MODELS (FOR TRANSITION)
// -------------------------------------------------------------
model AttendanceClass {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  courseCode   String   @db.VarChar(50)
  courseName   String   @db.VarChar(255)
  term         String   @db.VarChar(50)
  instructorId String   @map("instructor_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instructor   User     @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  sessions     AttendanceSession[]

  @@map("attendance_classes")
}

model AttendanceSession {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  date      DateTime @db.Timestamptz()
  topic     String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classObj  AttendanceClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("legacy_attendance_sessions")
}

// =============================================================
// EVENTS MODULE
// =============================================================

model Event {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  title       String   @db.VarChar(255)
  description String?  @db.Text
  location    String?  @db.VarChar(255)
  startDate   DateTime @map("start_date") @db.Timestamptz()
  endDate     DateTime @map("end_date") @db.Timestamptz()
  capacity    Int      @default(0) // 0 = unlimited
  isActive    Boolean  @default(true) @map("is_active")

  registrations EventRegistration[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("events")
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  CANCELLED
}

model EventRegistration {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  eventId  String @map("event_id") @db.Uuid

  studentCode String             @map("student_code") @db.VarChar(50)
  studentName String             @map("student_name") @db.VarChar(255)
  status      RegistrationStatus @default(REGISTERED)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentCode])
  @@index([tenantId, eventId])
  @@map("event_registrations")
}
